{
  "name": "@neigo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'skip'",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "bun --env-file=../../.env run src/db/migrate.ts",
    "db:migrate:session-titles": "bun --env-file=../../.env run src/db/migrate-session-titles.ts",
    "db:migrate:remove-live2d": "bun --env-file=../../.env run src/db/migrate-remove-live2d.ts",
    "seed": "bun --env-file=../../.env run src/db/seed.ts",
    "seed:content": "bun --env-file=../../.env run src/db/seed-demo-content.ts",
    "seed:all": "pnpm seed && pnpm seed:content",
    "seed:fantasy-chars": "bun --env-file=../../.env run src/db/seed-fantasy-chars.ts",
    "seed:fantasy-content": "bun --env-file=../../.env run src/db/seed-fantasy-content.ts",
    "seed:fantasy-content-2": "bun --env-file=../../.env run src/db/seed-fantasy-content-2.ts",
    "seed:fantasy-all": "pnpm seed:fantasy-chars && pnpm seed:fantasy-content && pnpm seed:fantasy-content-2",
    "seed:dark-romance-chars": "bun --env-file=../../.env run src/db/seed-dark-romance-chars.ts",
    "seed:dark-romance": "bun --env-file=../../.env run src/db/seed-dark-romance.ts",
    "seed:dark-romance-all": "pnpm seed:dark-romance-chars && pnpm seed:dark-romance",
    "seed:batch-b-chars": "bun --env-file=../../.env run src/db/seed-batch-b-chars.ts",
    "seed:batch-b-fantasy": "bun --env-file=../../.env run src/db/seed-batch-b-fantasy.ts",
    "seed:batch-b-modern": "bun --env-file=../../.env run src/db/seed-batch-b-modern.ts",
    "seed:batch-b-all": "pnpm seed:batch-b-chars && pnpm seed:batch-b-fantasy && pnpm seed:batch-b-modern",
    "sprites:gen": "bun run src/db/generate-placeholder-sprites.ts",
    "sprites:stitch": "bun run src/db/stitch-sprites.ts",
    "test:replay": "bun run src/services/orchestrator-replay.ts",
    "tokens:retokenize": "bun --env-file=../../.env run src/scripts/retokenize-lorebooks.ts",
    "lineage:gc": "bun --env-file=../../.env run src/scripts/gc-lineage.ts",
    "lineage:backfill": "bun --env-file=../../.env run src/scripts/backfill-lineage.ts",
    "bench:memory": "bun --env-file=../../.env run benchmarks/longmemeval.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1036.0",
    "@hono/zod-validator": "^0.7.6",
    "@neigo/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.1",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.15",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^5.0.8",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.5",
    "sanitize-html": "^2.17.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  }
}
